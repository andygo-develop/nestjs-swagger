{
  "name": "@andygo.dev/nestjs-swagger",
  "version": "1.1.0",
  "description": "Drop-in NestJS Swagger module: basic-auth-protected UI, per-version documents and discriminator examples, configured from a single URI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint \"{src,tests}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --max-warnings=0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "preversion": "npm run lint && npm test && npm run build",
    "release": "[ \"$(git rev-parse --abbrev-ref HEAD)\" = \"main\" ] || { echo 'Error: not on main branch'; exit 1; } && [ -z \"$(git status --porcelain)\" ] || { echo 'Error: uncommitted changes'; exit 1; } && [ -z \"$(git log @{u}..HEAD --oneline)\" ] || { echo 'Error: unpushed commits'; exit 1; } && [ -z \"$(git log HEAD..@{u} --oneline)\" ] || { echo 'Error: local main is behind origin/main'; exit 1; } && npm publish --access public",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "example": "ts-node --project tsconfig.examples.json examples/main.ts"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "basic-auth",
    "versioning",
    "typescript"
  ],
  "homepage": "https://github.com/andygo-develop/nestjs-swagger#readme",
  "bugs": {
    "url": "https://github.com/andygo-develop/nestjs-swagger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andygo-develop/nestjs-swagger.git"
  },
  "author": "Andy Kramar <andygo.develop@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^8.0.0 || ^11.0.0"
  },
  "dependencies": {
    "express-basic-auth": "^1.2.1",
    "openapi-sampler": "^1.7.6"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.1.3",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "jest": "29.7.0",
    "openapi3-ts": "^4.6.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "diagnostics": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  }
}
